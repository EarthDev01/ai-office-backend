APP_MODE=dev
HTTP_PORT=6767

# ---- ฐานข้อมูลของระบบ AI เราเอง ----
STORE_DRIVER=mongo
DB_NAME=ai_office
DB_URI=mongodb+srv:

CONSOLE_JWT_SECRET=&AIOFFICE
# ---- LLM ----
# โมเดลและ API key ตั้งที่คอนโซล (ตั้งค่าระบบ → โมเดล AI) · key เก็บใน DB แบบเข้ารหัสด้วยกุญแจหลักตัวนี้
# สร้างด้วย: openssl rand -base64 32 · ██ เก็บสำรองไว้ที่ปลอดภัย — หาย = key ใน DB ถอดไม่ได้ ต้องตั้งใหม่ทุกตัว
# production ต้องมี · dev ไม่มี = ตั้ง key จากคอนโซลไม่ได้ ใช้ key ข้างล่างแทน
LLM_KEY_SECRET=
# ไม่บังคับ — ถ้าใส่ไว้ ระบบย้ายเข้า DB (เข้ารหัส) ให้ครั้งแรกที่เปิด server แล้วลบออกจากไฟล์นี้ได้
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ไม่บังคับ — โมเดลตั้งต้นครั้งแรกก่อนบันทึกจากคอนโซล (ค่าเริ่มต้น anthropic · claude-sonnet-5 · low)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_EFFORT=low
# LLM_BASE_URL=
