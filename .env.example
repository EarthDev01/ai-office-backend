# ai-office-backend — ตัวอย่าง env (copy เป็น .env สำหรับเครื่อง dev · บน K8s ใช้ Secret/ConfigMap)
# ██ ห้ามใส่ค่าจริงในไฟล์นี้ · .env อยู่ใน .gitignore แล้ว

# dev | production (production = ตรวจ secret/Mongo/Redis ตอน boot)
APP_MODE=dev
HTTP_PORT=6767

# ---- ฐานข้อมูลของระบบ AI เราเอง ----
# mongo | file (file = dev เร็ว ๆ ไม่ต้องมี Mongo)
STORE_DRIVER=mongo
DB_NAME=ai_office
# ██ secret · เช่น mongodb://localhost:27017 (docker-compose.dev.yml)
DB_URI=

# ---- Redis: ตัวนับพร้อมกัน/โควตา/แคช (บังคับบน production) ----
# เช่น redis://localhost:6379/0
REDIS_URL=

# ---- ความลับ (production ต้องยาว ≥ 32 ตัวอักษร · สุ่มใหม่ต่อ environment) ----
# ██ secret · เซ็น session ของคอนโซล
CONSOLE_JWT_SECRET=
# ██ secret · เซ็นตั๋ว widget + ปิดผนึก grant ของ host
TICKET_SECRET=

# ---- โมเดล ----
# ██ secret · ไม่ตั้ง = แชทตอบ "ผู้ช่วยไม่พร้อมใช้งาน"
ANTHROPIC_API_KEY=

# ---- อื่น ๆ ----
CONNECTORS_DIR=./connectors
# ██ secret · แจ้งเตือนโควตา 80/95/100% (ไม่ตั้ง = log อย่างเดียว)
TELEGRAM_BOT_TOKEN=
# ถ้าตั้ง /metrics ต้องส่ง Authorization: Bearer <ค่านี้>
METRICS_TOKEN=
