# ---- server ----
# dev = เปิด /dev/session ไว้จำลองการล็อกอินให้หน้า office · production = ปิด
APP_MODE=dev
HTTP_PORT=6767
# :5173 = คอนโซล report · :5174 = หน้า office จำลอง
HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- store ----
# mongo = ใช้ MongoDB · file = เก็บลงไฟล์ JSON (ค่าเริ่มต้น ไว้ dev เร็ว ๆ)
STORE_DRIVER=mongo
DB_NAME=ai_office
# ██ SECRET — ใส่ค่าจริงใน .env เท่านั้น (.env ถูก gitignore แล้ว)
# ██ ห้าม copy ค่านี้ลง commit, log, เอกสาร หรือแชท
DB_URI=mongodb+srv://<username>:<password>@ai-office.xn9m6hp.mongodb.net/?appName=AI-OFFICE

# ใช้เมื่อ STORE_DRIVER=file
CONFIG_STORE_PATH=./data/offices.json

# ---- console auth (DEMO) ----
# รอบนี้เป็น static token · ของจริงต้องเป็น JWT คนละ secret กับแอดมินเว็บ (02-SPEC §6)
ADMIN_CONSOLE_TOKEN=dev-console-token
