{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "test"
  ]
}
